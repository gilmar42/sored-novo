{
  "name": "sored-novo",
  "version": "1.0.0",
  "description": "SORED - Sistema de Orçamento Rápido Industrial",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:backend": "npm --prefix backend run build",
    "build:hostinger": "npm run build && npm run build:backend",
    "start": "next start -p $PORT",
    "start:backend": "npm --prefix backend start",
    "hostinger:install": "npm ci && npm --prefix backend ci",
    "hostinger:start": "pm2 start ecosystem.config.cjs --update-env",
    "hostinger:start:backend": "pm2 start ecosystem-backend.config.cjs --update-env",
    "hostinger:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "hostinger:reload:backend": "pm2 reload ecosystem-backend.config.cjs --update-env",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "jest"
  },
  "keywords": [],
  "author": "SORED Team",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@prisma/client": "6.19.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.10.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "date-fns": "4.1.0",
    "glob": "^13.0.6",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "11.2.7",
    "lucide-react": "0.577.0",
    "mercadopago": "^2.12.0",
    "next": "14.2.15",
    "postcss": "^8.4.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.48.2",
    "react-query": "^3.39.3",
    "rimraf": "6.1.3",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
