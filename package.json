    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "prisma": "6.4.1",
    "ts-jest": "^29.1.1",
    "typescript-eslint": "^8.57.2"
  }
}
