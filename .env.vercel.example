# Configurações de Ambiente - Vercel Frontend
NEXT_PUBLIC_API_URL=https://api.sored-industrial.com/api
NEXT_PUBLIC_APP_URL=https://sored-industrial.vercel.app
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_NAME=SORED - Sistema de Orçamento Industrial
NEXT_PUBLIC_APP_DESCRIPTION=Plataforma completa para gestão e geração de orçamentos industriais
NEXT_PUBLIC_SUPPORT_EMAIL=contato@sored-industrial.com
NEXT_PUBLIC_COMPANY_NAME=SORED Industrial Solutions
NEXT_PUBLIC_COMPANY_DOCUMENT=12.345.678/0001-90
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_VERSION=1.0.0

# Configurações de build
ANALYZE=false
NODE_ENV=production

# Configurações de features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_CHAT_SUPPORT=true

# Configurações de Mercado Pago (produção)
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Configurações de Mercado Pago (testes)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
