# Configurações de Produção - SORED
PORT=3001
MONGODB_URI=mongodb://localhost:27017/sored_prod
JWT_SECRET=super_secure_jwt_secret_for_production_change_this_in_production_2024
JWT_EXPIRES_IN=7d
NODE_ENV=production
BASE_URL=https://sored-industrial.com
ALLOWED_ORIGINS=https://sored-industrial.com,https://www.sored-industrial.com

# Mercado Pago - Credenciais de Produção
# IMPORTANTE: Substitua com suas credenciais reais do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret_here

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=contato@sored-industrial.com
EMAIL_PASS=your_app_password_here

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=https://sored-industrial.com,https://www.sored-industrial.com,https://admin.sored-industrial.com

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=session_secret_for_production_change_this

# Database
DB_NAME=sored_prod
DB_MAX_POOL_SIZE=10
