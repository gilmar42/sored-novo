# Frontend (Next.js) - producao

# URL de origem do backend usada pelas rotas /api/* do Next para proxy.
# Em produção, use a origem sem /api (ex: https://api.seudominio.com).
# Se o backend roda no mesmo servidor/processo, pode ser http://127.0.0.1:3001
BACKEND_URL=http://127.0.0.1:3001

# Prisma (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# JWT (usado nas rotas /api/auth/* do Next)
JWT_SECRET=troque-por-um-segredo-forte

# URLs publicas (usadas em alguns endpoints como PDF)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Mercado Pago (opcional no frontend)
# Usado como fallback por `GET /api/payments/public-key` caso o backend esteja indisponível.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Opcional: se quiser forcar chamadas do axios para um backend externo.
# Pode incluir /api; as rotas proxy do Next removem esse sufixo automaticamente.
# NEXT_PUBLIC_API_URL=https://seu-dominio.com/api
