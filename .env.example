# Frontend (Next.js) - producao

# URL do backend (usado pelas rotas /api/* do Next para proxy).
# Se o backend roda no mesmo servidor, pode ser http://localhost:3001
BACKEND_URL=http://localhost:3001

# Prisma (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# JWT (usado nas rotas /api/auth/* do Next)
JWT_SECRET=troque-por-um-segredo-forte

# URLs publicas (usadas em alguns endpoints como PDF)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Opcional: se quiser forcar chamadas do axios para um backend externo
# NEXT_PUBLIC_API_URL=https://seu-dominio.com/api

