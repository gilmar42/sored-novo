# Frontend (Next.js) - producao

# Prisma (MariaDB / MySQL)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB

# JWT (usado nas rotas /api/auth/* do Next)
JWT_SECRET=troque-por-um-segredo-forte

# URLs publicas (usadas em alguns endpoints como PDF)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Mercado Pago - Processamento LOCAL (recomendado)
# Configure para processar pagamentos diretamente no Next.js sem backend externo
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Opcional: URL do backend externo (apenas se não usar processamento local)
# BACKEND_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_API_URL=https://api.seudominio.com/api
