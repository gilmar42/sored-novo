# Configurações de build
ANALYZE=false
NODE_ENV=development

# Configurações de features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_CHAT_SUPPORT=false
