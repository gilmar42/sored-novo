# Template de ambiente de produção para o backend.
# Renomeie para `.env.production` (ou crie o secret equivalente) e preencha
# com os valores reais antes de subir para o deploy. Não comite valores secretos.

PORT=3001
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/sored?retryWrites=true&w=majority
JWT_SECRET=seu_jwt_super_secreto
JWT_EXPIRES_IN=7d

# URLs e CORS
BASE_URL=https://api.sored.com
FRONTEND_URL=https://app.sored.com
ALLOWED_ORIGINS=https://app.sored.com,https://admin.sored.com

# Mercado Pago - produção
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADO_PAGO_WEBHOOK_SECRET=webhook_secret_definido_pelo_mercado_pago

# Email (opcional, substitua se enviará e-mails reais)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=contato@seu-dominio.com
EMAIL_PASS=sua_senha

# Configurações de upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
