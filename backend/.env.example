# Configurações básicas
PORT=3001
MONGODB_URI=mongodb://localhost:27017/sored
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# URL pública que o Mercado Pago consegue acessar para webhooks.
# Em produção precisa ser HTTPS e NÃO pode ser localhost.
# Exemplos válidos:
# - https://api.seudominio.com  (webhook direto no backend)
# - https://app.seudominio.com  (webhook bate no Next e ele faz proxy pro backend)
BASE_URL=http://localhost:3001

# URL pública do frontend (para returnUrl do checkout)
# Em produção precisa ser HTTPS.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mercado Pago - Credenciais de TESTE (Sandbox)
# Obtenha em: https://developers.mercadopago.com.br > Credenciais de teste
MERCADO_PAGO_ACCESS_TOKEN=TEST-123456789012345678901234567890123456
MERCADO_PAGO_PUBLIC_KEY=TEST-12345678-1234-1234-1234-123456789012

# Mercado Pago - Webhook Secret (recomendado em produção)
MERCADO_PAGO_WEBHOOK_SECRET=

# Opcional: tolerância de tempo do header `ts` do x-signature (anti-replay)
# Padrão: 600000 (10 minutos)
MERCADO_PAGO_WEBHOOK_TOLERANCE_MS=600000

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
