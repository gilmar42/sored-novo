# SORED - Backend/Express (pagamentos) em produção na Hostinger

PORT=3001
NODE_ENV=production

# O backend usa o mesmo MariaDB do app principal via Prisma.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB

# Deve ser o mesmo valor usado no .env da raiz.
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# No cenário recomendado de 1 domínio, o webhook do Mercado Pago entra
# pela mesma origem pública do app e o Nginx encaminha /api/* para o backend.
BASE_URL=https://sored-orcamento-rapido-profissional.com
FRONTEND_URL=https://sored-orcamento-rapido-profissional.com
ALLOWED_ORIGINS=https://sored-orcamento-rapido-profissional.com,https://www.sored-orcamento-rapido-profissional.com

# Mercado Pago - mantenha a integração ativa em produção.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_MS=600000

# Email
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USER=no-reply@seudominio.com
EMAIL_PASS=troque-por-uma-senha-forte

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
