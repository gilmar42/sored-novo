# SORED - Next.js em produção na Hostinger (Business Web Hosting / Node.js Web App)

# Banco MariaDB usado pelo Prisma no app Next.js.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB

# Segredo JWT compartilhado com o backend.
JWT_SECRET=troque-por-um-segredo-forte

# URL pública do app.
NEXT_PUBLIC_APP_URL=https://sored-orcamento-rapido-profissional.com

# Mercado Pago no próprio app Next.js.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_MS=600000

# Opcional:
# só use BACKEND_URL/NEXT_PUBLIC_API_URL se você realmente mantiver um backend externo separado.
# BACKEND_URL=https://api.seudominio.com
# NEXT_PUBLIC_API_URL=https://api.seudominio.com/api
