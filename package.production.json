{
  "name": "sored-production-scripts",
  "description": "Scripts para deploy em produção",
  "scripts": {
    "build:frontend": "cd . && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "start:frontend": "npm start",
    "start:backend": "cd backend && npm start",
    "start:prod": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "deploy:setup": "npm install && cd backend && npm install",
    "deploy:build": "npm run build:all",
    "deploy:start": "NODE_ENV=production npm run start:prod"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
